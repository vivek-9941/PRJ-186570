      "title": "DAG execution latency (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": null,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(dag_execution_time_seconds_bucket[1m]))",
          "legendFormat": "p50",
          "refId": "A"
