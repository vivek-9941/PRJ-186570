{
  "info": {
    "_postman_id": "9d8ef59a-5d58-4af7-b4c3-5b9f42b74f22",
    "name": "Trade Orchestration Local Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Place BUY order (LIMIT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 202\", () =>",
              "  pm.response.to.have.status(202));",
              "pm.environment.set(\"orderId\",",
              "  pm.response.json().orderId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"demo-user\",\n  \"symbol\": \"INFY\",\n  \"side\": \"BUY\",\n  \"quantity\": 10,\n  \"price\": 1850,\n  \"orderType\": \"LIMIT\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/orders",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "v1",
            "orders"
          ]
        }
      }
    },
    {
